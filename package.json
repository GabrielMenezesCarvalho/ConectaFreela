{
  "name": "conectafreela",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"npm run dev -w web\" \"npm run start:dev -w api\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "build": "npm run build -w api && npm run build -w web",
    "lint": "npm run lint -w api && npm run lint -w web",
    "test": "npm run test -w api -- --runInBand",
    "db:generate": "npm run prisma:generate -w api",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:studio": "npm run prisma:studio -w api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
