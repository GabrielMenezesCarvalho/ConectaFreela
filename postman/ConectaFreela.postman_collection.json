    {
      "name": "POST - Criar talento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('userId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Talento Postman\",\n  \"email\": \"talento.postman.{{$timestamp}}@example.com\",\n  \"password\": \"Senha123!\",\n  \"role\": \"TALENT\",\n  \"skills\": [\"React\", \"TypeScript\"],\n  \"availability\": \"Até 5 horas por semana\",\n  \"bio\": \"Conta criada durante a demonstração.\",\n  \"portfolioLinks\": [\"https://github.com/example\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users"
      }
    },
    {
